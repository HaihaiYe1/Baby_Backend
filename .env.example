# 应用配置
APP_NAME=Baby Monitor API
APP_VERSION=1.0.0
DEBUG=false

# 数据库配置
DATABASE_URL=mysql+pymysql://fastapi:password@localhost/baby
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=fastapi
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=baby

# JWT配置
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 小米MiMo API配置
MIMO_API_KEY=your_mimo_api_key
MIMO_BASE_URL=https://api.mimo.xiaomi.com/v1
MIMO_MODEL=MiMo-V2.5-Pro

# MQTT配置
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# WebSocket配置
WS_HEARTBEAT_TIMEOUT=30

# CORS配置
CORS_ORIGINS=["*"]
