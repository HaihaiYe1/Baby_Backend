# ===========================================
# Baby Monitor 环境变量配置
# 复制此文件为 .env 并填写真实配置
# ===========================================

# 应用配置
APP_NAME=Baby Monitor API
APP_VERSION=1.0.0
DEBUG=false

# ===========================================
# 数据库配置 (必填)
# ===========================================
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=baby
DATABASE_URL=mysql+pymysql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}

# ===========================================
# JWT 认证配置 (必填)
# 请使用随机生成的强密钥，例如: openssl rand -hex 32
# ===========================================
SECRET_KEY=your-super-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===========================================
# 小米 MiMo API 配置 (必填)
# ===========================================
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://api.mimo.xiaomi.com/v1
MIMO_MODEL=MiMo-V2.5-Pro

# ===========================================
# MQTT 配置 (可选)
# ===========================================
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ===========================================
# WebSocket 配置
# ===========================================
WS_HEARTBEAT_TIMEOUT=30

# ===========================================
# CORS 配置 (生产环境请设置具体域名)
# ===========================================
# CORS_ORIGINS=["https://yourdomain.com"]
